#include <stdio.h>

int main() {
    int tcpDropped = 5;
    int udpDropped = 8;
    int congestionDropped = 13;
    int totalDropped = tcpDropped + udpDropped;

    double dataRate[] = {1, 5, 10};
    double throughput[] = {0.8, 4.2, 8.5};

    printf("NS2 Network Simulation Results\n");
    printf("------------------------------\n");

    printf("TCP packets dropped: %d\n", tcpDropped);
    printf("UDP packets dropped: %d\n", udpDropped);
    printf("Total packets dropped: %d\n", totalDropped);
    printf("Packets dropped due to congestion: %d\n",
           congestionDropped);

    printf("\nData Rate and Throughput Comparison\n");
    printf("-----------------------------------\n");
    printf("Data Rate (Mbps)\tThroughput (Mbps)\n");

    for (int i = 0; i < 3; i++) {
        printf("%.1f\t\t\t%.1f\n",
               dataRate[i], throughput[i]);
    }

    printf("\nSimulation completed successfully.\n");

    return 0;
}
